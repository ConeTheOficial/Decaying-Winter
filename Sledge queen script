local function doAttack(targetPos)
    local hrp = game:GetService("Players").LocalPlayer.Character.HumanoidRootPart
    local char = game:GetService("Players").LocalPlayer.Character
    local plr = game:GetService("Players").LocalPlayer

    local queenanim = plr.Character.Humanoid:LoadAnimation(game.ReplicatedStorage.animationSets.TPanimSets.special.queen_jump)
    queenanim:Play()

    workspace.ServerStuff.playAudio:FireServer({"perks"}, "shotshell_windup", hrp)
    wait(0.3)
    hrp.AssemblyLinearVelocity = Vector3.new(0,100,0)
    workspace.ServerStuff.playAudio:FireServer({"perks"}, "shotshell_fire", hrp)
    workspace.ServerStuff.applyGore:FireServer("shotshell_blast", char, plr, {hrp.Position - Vector3.new(0,1.5,0)})

    wait(0.4)
    workspace.ServerStuff.applyGore:FireServer("shotshell_blast", char, plr, {hrp.Position - hrp.CFrame.lookVector*-2.5})

    local bp = Instance.new("BodyPosition", hrp)
    bp.MaxForce = Vector3.new(10000000,10000000,10000000)
    bp.P = 27500
    bp.Position = targetPos
    spawn(function()
        wait(0.6)
        bp:Destroy()
    end)

    workspace.ServerStuff.playAudio:FireServer({"perks"}, "shotshell_fire", hrp)
    wait(0.1)

    local queenanim2 = plr.Character.Humanoid:LoadAnimation(game.ReplicatedStorage.animationSets.TPanimSets.special.queen_jump_attack)
    queenanim2:Play()
    wait(0.4)

    workspace.ServerStuff.playAudio:FireServer({"general"}, "mineexplosion", hrp)
    workspace.ServerStuff.applyGore:FireServer("shotshell_blast", char, plr, {hrp.Position + hrp.CFrame.lookVector*2.5 - Vector3.new(0,1.5,0)})
    workspace.ServerStuff.playAudio:FireServer({"perks"}, "shotshell_punch_hit", hrp)
    workspace.ServerStuff.playAudio:FireServer({"perks"}, "tick_explosion", hrp)

    local offsets = {
        Vector3.new(0,1.5,0),
        Vector3.new(0,6.5,0),
        Vector3.new(0,-3.5,0),
        Vector3.new(0,1.5,5),
        Vector3.new(5,1.5,0),
        Vector3.new(-5,1.5,0),
        Vector3.new(0,1.5,-5),
    }
    for _, offset in ipairs(offsets) do
        workspace.ServerStuff.dealDamage:FireServer(
            "shotshell",
            {hrp.Position + hrp.CFrame.lookVector*2.5 - offset}
        )
    end

    wait(0.4)
    workspace.ServerStuff.playAudio:FireServer({"perks"}, "shotshell_pump", hrp)
end

local cooldown = false
ms.KeyDown:connect(function(Key)
    if Key == enemykey and active == true then
        if cooldown == false then
            cooldown = true
            local closestDistance, closestHumanoid = math.huge, nil
            for _, humanoid in ipairs(workspace.activeHostiles:GetDescendants()) do
                if humanoid:IsA("Humanoid") then
                    local humanModel = humanoid:FindFirstAncestorOfClass("Model")
                    if humanModel and humanModel.PrimaryPart then
                        local distance = lp:DistanceFromCharacter(humanModel.PrimaryPart.Position)
                        if distance < closestDistance then
                            closestDistance = distance
                            closestHumanoid = humanModel
                        end
                    end
                end
            end
            if closestHumanoid ~= nil then
                doAttack(closestHumanoid.HumanoidRootPart.Position)
            end
            wait(0) -- usage cooldown
            cooldown = false
        end
    end

    if Key == cursorkey and active == true then
        if cooldown == false then
            cooldown = true
            doAttack(ms.hit.Position)
            wait(0) -- usage cooldown
            cooldown = false
        end
    end

    if Key == "n" and active == true then
        active = false
    end
end)

