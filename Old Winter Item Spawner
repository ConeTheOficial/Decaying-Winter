local function resolveWait()
    while true do
        local result = workspace.ServerStuff.ask:InvokeServer(mainHandler.Name, true)
        if result then
            local index = result
            local step = list[index]
            local remote = step and pseed[step]
            if remote then
                return remote, index, step
            end
        end
        task.wait(0.1)
    end
end

